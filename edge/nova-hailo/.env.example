# Nova-Hailo env — copy to .env and fill in.
#   cp .env.example .env
# Never commit .env. Preflight WARNs (does not fail) when keys are missing;
# chat still runs; tools return fail-closed "can't reach that service".

# --- Web search: Exa only (required for web_search) ---
EXA_API_KEY=
# Unused by the live pipeline (kept so old .env files still parse):
# BRAVE_API_KEY=
# SERPER_API_KEY=

# --- Deep research (Tavily) ---
TAVILY_API_KEY=

# --- Google Workspace OAuth (calendar / gmail / drive read-only) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
GOOGLE_OAUTH_TOKEN_PATH=runtime/google_oauth/tokens.json
# Authorize: Settings → Connect with Google, or:
#   python3 scripts/google_oauth_auth.py

# --- Optional overrides (env wins over YAML; leave unset for config defaults) ---
# NOVA_HAILO_PROFILE=oem
# NOVA_HAILO_CONFIG=config.oem_v002_test.yaml
# NOVA_HAILO_TTS=piper
# NOVA_HAILO_LLM=qwen2
# NOVA_HAILO_PLAYBACK=browser
# NOVA_HAILO_PORT=8766
