# Nova-Hailo OEM / web demo env — copy to .env and fill in.
#   cp .env.example .env && nano .env
# Never commit .env. Preflight warns (does not fail) when keys are missing;
# chat still runs; Workspace/search tools return "can't reach that service".

# --- Web search (v0.0.1: Brave primary → Serper fallback) ---
BRAVE_API_KEY=
SERPER_API_KEY=

# --- Deep research (Tavily advanced search; async job on device) ---
TAVILY_API_KEY=

# --- Google Workspace OAuth (read-only calendar / gmail / drive; deferred past v0.0.1) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match Google Cloud OAuth client (Nova default — port 8765, not 8000):
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
# Token file written after one-time OAuth (refresh_token required):
GOOGLE_OAUTH_TOKEN_PATH=runtime/google_oauth/tokens.json
# Authorize once from Settings → Connect with Google (or:
#   python3 scripts/google_oauth_auth.py)


# --- Optional demo knobs ---
# NOVA_HAILO_PROFILE=oem
# NOVA_HAILO_TTS=piper
# NOVA_HAILO_LLM=qwen2
# NOVA_HAILO_PLAYBACK=browser
# NOVA_HAILO_PORT=8766
